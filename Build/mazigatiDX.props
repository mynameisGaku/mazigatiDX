<?xml version="1.0" encoding="utf-8"?>
<!--
  mazigatiDX の共通ビルド設定。
  フレームワーク本体（mazigatiDX.vcxproj）と、フレームワークを使うプロジェクト（ゲーム・ツール）が、Microsoft.Cpp.props の後で取り込む。

    <ImportGroup Label="PropertySheets">
      <Import Project="<フレームワークのフォルダー>\Build\mazigatiDX.props" />
    </ImportGroup>

  ゲーム・ツール（ConfigurationType が Application）のプロジェクトは、フレームワーク本体のプロジェクトへの参照も持つ。
    <ProjectReference Include="<フレームワークのフォルダー>\mazigatiDX.vcxproj"> <Project>{0A3D6F51-8C2E-4B7A-9D14-5E6F7081A2B3}</Project> </ProjectReference>
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- フレームワークのフォルダー（末尾に \ つき）。#include "Library/..." の基準 -->
    <MazigatiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</MazigatiRoot>
    <!-- DxLib の場所。別の場所に置いたときは、同じ名前の環境変数かプロジェクトのプロパティで上書きする -->
    <MazigatiDxLibDir Condition="'$(MazigatiDxLibDir)' == '' and '$(MazigatiWithoutDxLib)' != 'true'">C:\DxLib</MazigatiDxLibDir>
    <MazigatiDxLibVcDir Condition="'$(MazigatiDxLibVcDir)' == '' and '$(MazigatiWithoutDxLib)' != 'true'">C:\DxLib_VC\プロジェクトに追加すべきファイル_VC用</MazigatiDxLibVcDir>
  </PropertyGroup>

  <!-- バックエンドを、プリプロセッサで切り分けるためのマクロ（Library/Core/Types/BackendMacros.h）。全プロジェクトに同じ値を渡す。
         /p:MazigatiBackend=dxlib|dx12|null   このビルドは、その実装に固定する（指定なしは、実行時に起動の引数 backend で選ぶ）
         /p:MazigatiWithoutDxLib=true / MazigatiWithoutDX12=true   組み込まない実装（コンパイル対象からも外す。下の Target） -->
  <PropertyGroup>
    <MazigatiBackendDefines Condition="'$(MazigatiBackend)' == 'dxlib'">MAZIGATI_BACKEND=1;$(MazigatiBackendDefines)</MazigatiBackendDefines>
    <MazigatiBackendDefines Condition="'$(MazigatiBackend)' == 'dx12'">MAZIGATI_BACKEND=2;$(MazigatiBackendDefines)</MazigatiBackendDefines>
    <MazigatiBackendDefines Condition="'$(MazigatiBackend)' == 'null'">MAZIGATI_BACKEND=3;$(MazigatiBackendDefines)</MazigatiBackendDefines>
    <MazigatiBackendDefines Condition="'$(MazigatiWithoutDxLib)' == 'true'">MAZIGATI_WITHOUT_DXLIB;$(MazigatiBackendDefines)</MazigatiBackendDefines>
    <MazigatiBackendDefines Condition="'$(MazigatiWithoutDX12)' == 'true'">MAZIGATI_WITHOUT_DX12;$(MazigatiBackendDefines)</MazigatiBackendDefines>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>$(MazigatiBackendDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 文字列リテラルを UTF-8 にする（FString は UTF-8）。ソースは BOM つき UTF-8 で書く（BOM のあるファイルは、自動で UTF-8 として読まれる）。
           /utf-8 にしないのは、BOM なしの Shift-JIS の DxLib のヘッダーを、UTF-8 として読んで壊さないため -->
      <AdditionalOptions>/execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- 同名の .cpp が別のフォルダーにあっても .obj が衝突しないよう、元のフォルダー構成のまま出力する -->
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
      <!-- プロジェクトのフォルダー（#include "Source/..."）、フレームワークのフォルダー（#include "Library/..."）、第三者のライブラリ、DxLib -->
      <AdditionalIncludeDirectories>$(ProjectDir);$(MazigatiRoot)VendorModules\SDL3\include;$(MazigatiRoot);$(MazigatiRoot)VendorModules;$(MazigatiDxLibVcDir);$(MazigatiDxLibDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MazigatiRoot)VendorModules\SDL3\lib\$(PlatformTarget);$(MazigatiDxLibVcDir);$(MazigatiDxLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- main で始められるようにする（WinMain を書かなくてよい。コンソールの窓は出ない） -->
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <!-- サブシステムの登録（REGISTER_SUBSYSTEM）や、コンソールコマンドの登録は、静的な初期化で行う。
           静的ライブラリの .obj は、参照されないとリンクされず登録が消えるので、ライブラリ全体を取り込む -->
      <AdditionalOptions>/WHOLEARCHIVE:mazigatiDX.lib %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- Debug の速さ: /JMC（Just My Code。全関数の入口に、呼び出しを 1 つ足す）を切り、/Ob1（FORCEINLINE の関数だけをインライン展開する。/Od のままだと、FORCEINLINE も展開されない）にする。
           ブレークポイントと変数の確認は、今までどおり使える（Debug の Deferred のゲームスレッドで、/JMC の呼び出しだけで約 24%） -->
      <SupportJustMyCode>false</SupportJustMyCode>
      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>JPH_ENABLE_ASSERTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <!-- 静的ライブラリは、デバッグ情報を .obj の中に持つ（/Z7）。.obj が .pdb を指す形（/Zi）だと、Release のリンクで LNK4020（型レコードが壊れている）が出るうえ、
       並列コンパイルで .pdb の取り合いも起きる。実行ファイルのリンクが、全部をまとめて 1 つの .pdb にする -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)'=='StaticLibrary'">
    <ClCompile>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- /p:MazigatiWithoutDxLib=true のときは、Library/Platform/DxLib と Source/SelfTest をコンパイル対象から外し、DxLib なしでリンクできることを確かめる -->
  <Target Name="ExcludeDxLibSources" BeforeTargets="CreateObjectDirectories;ClCompile" Condition="'$(MazigatiWithoutDxLib)'=='true'">
    <ItemGroup>
      <ClCompile Remove="$(MazigatiRoot)Library\Platform\DxLib\**;Library\Platform\DxLib\**;Source\SelfTest\**" />
    </ItemGroup>
  </Target>

  <!-- DX12を組み込まない配布向け。共通のキャンバス・Windows実装は残す -->
  <Target Name="ExcludeDX12Sources" BeforeTargets="CreateObjectDirectories;ClCompile" Condition="'$(MazigatiWithoutDX12)'=='true'">
    <ItemGroup>
      <ClCompile Remove="$(MazigatiRoot)Library\Platform\DX12\**;Library\Platform\DX12\**;$(MazigatiRoot)VendorModules\ImGui\imgui_impl_dx12.cpp;VendorModules\ImGui\imgui_impl_dx12.cpp" />
    </ItemGroup>
  </Target>

  <!-- ObjectFileName=$(IntDir)%(RelativeDir) 用の出力ディレクトリを作成（同名 .cpp の衝突回避） -->
  <Target Name="CreateObjectDirectories" BeforeTargets="ClCompile">
    <MakeDir Directories="@(ClCompile->'$(IntDir)%(RelativeDir)')" />
  </Target>

  <!-- SDL3.dll を実行ファイルの隣へコピーする（実行ファイルを作るプロジェクトだけ。静的ライブラリは Link を通らない） -->
  <Target Name="CopySdlDll" AfterTargets="Link">
    <Copy SourceFiles="$(MazigatiRoot)VendorModules\SDL3\lib\$(PlatformTarget)\SDL3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(MazigatiRoot)VendorModules\SDL3\lib\$(PlatformTarget)\SDL3.dll')" />
  </Target>
</Project>
