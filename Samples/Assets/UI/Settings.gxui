<?xml version="1.0" encoding="UTF-8"?>
<!-- サンプル UI の設定の窓。ビューモデルの値は {Binding 名前}、色・数は @名前（テーマ）、フォント・ブラシ・スタイルも名前（テーマ）で書いてある。
     Theme ボタンでテーマを替えると、同じこのファイルから、色の違う窓が作り直される。
     このファイルを保存すると、動いているサンプルの窓が、作り直される（ホットリロード）。
     <Animation> は、窓が作られたときの動き。ボタンの HoverScale・PressedScale は、乗ったとき・押したときの大きさ。 -->
<Panel Name="SettingsWindow" Background="Window" Padding="28,24">
  <Animation Property="Opacity" From="0" To="1" Duration="0.3" />
  <Animation Property="TranslationY" From="28" To="0" Duration="0.45" Easing="BackOut" />
  <VerticalStack Spacing="@Spacing">
    <Label Text="Settings" Font="Title" Color="@Accent" HAlign="Start" VAlign="Center" />

    <HorizontalStack Spacing="@Gap" Height="28">
      <CheckBox Name="MusicBox" Checked="{Binding Music}" Style="Default" Width="28" Height="28" HAlign="Start" VAlign="Center" />
      <Label Text="Music" Font="Body" Color="@Text" HAlign="Start" VAlign="Center" />
    </HorizontalStack>
    <HorizontalStack Spacing="@Gap" Height="28">
      <CheckBox Name="SoundBox" Checked="{Binding Sound}" Style="Default" Width="28" Height="28" HAlign="Start" VAlign="Center" />
      <Label Text="Sound effects" Font="Body" Color="@Text" HAlign="Start" VAlign="Center" />
    </HorizontalStack>

    <HorizontalStack Spacing="@Gap" Height="28">
      <Label Text="Volume" Font="Body" Color="@Text" HAlign="Start" VAlign="Center" />
      <Label Text="{Binding VolumeText}" Font="Body" Color="@Value" HAlign="Start" VAlign="Center" />
    </HorizontalStack>
    <Slider Name="VolumeSlider" Value="{Binding Volume}" Min="0" Max="100" Step="5" Height="28" Style="Thin" Tooltip="Drag it, or use the left and right keys" />
    <ProgressBar Name="VolumeBar" Value="{Binding VolumeRatio}" Back="ProgressBack" Fill="ProgressFill" Height="18" />

    <HorizontalStack Spacing="@Gap" Height="38">
      <Label Text="Quality" Font="Body" Color="@Text" HAlign="Start" VAlign="Center" />
      <Dropdown Name="QualityBox" Items="{Binding QualityItems}" SelectedIndex="{Binding Quality}" Font="Body" Style="Default"
                Weight="1" Height="38" VAlign="Center" Tooltip="Pick how detailed the picture is" />
    </HorizontalStack>

    <HorizontalStack Spacing="@Gap" Height="38">
      <Label Text="Name" Font="Body" Color="@Text" HAlign="Start" VAlign="Center" />
      <TextBox Name="NameBox" Text="{Binding Name}" Placeholder="Type your name" MaxLength="16" Font="Body" Style="Default"
               Weight="1" Height="38" VAlign="Center" OnSubmitted="NameSubmitted" OnCancelled="NameCancelled"
               Tooltip="Drag or Shift + arrows to select. Double-click selects a word. Ctrl + C, X, V to copy, cut and paste." />
    </HorizontalStack>

    <!-- 複数行の入力欄: Enter で改行、上下で行を移る。長い行は、欄の幅で折り返す。行が増えると、縦にずれる（ホイールでも動く） -->
    <HorizontalStack Spacing="@Gap" Height="64">
      <Label Text="Memo" Font="Body" Color="@Text" HAlign="Start" VAlign="Start" />
      <TextBox Name="MemoBox" Text="{Binding Memo}" Placeholder="Notes (Enter makes a new line)" Multiline="true" WordWrap="true" MaxLength="200" Font="Body" Style="Default"
               Weight="1" Height="64" VAlign="Center" Tooltip="A multi-line box. Enter makes a new line, Tab leaves the box." />
    </HorizontalStack>

    <HorizontalStack Spacing="12" Height="44">
      <Button Name="Ok" Text="OK" Font="Body" TextColor="@Text" Width="108" Height="44" VAlign="Center" Style="Default" HoverScale="1.06" PressedScale="0.95" OnClicked="OkClicked" />
      <Button Name="Cancel" Text="Cancel" Font="Body" TextColor="@Text" Width="108" Height="44" VAlign="Center" Style="Default" HoverScale="1.06" PressedScale="0.95" OnClicked="CancelClicked" />
      <Button Name="Reset" Text="Reset" Font="Body" TextColor="@Text" Width="108" Height="44" VAlign="Center" Style="Default" HoverScale="1.06" PressedScale="0.95" Command="{Binding Reset}" Tooltip="Back to the defaults (asks first)" />
      <Button Name="Theme" Text="Theme" Font="Body" TextColor="@Accent" Width="108" Height="44" VAlign="Center" Style="Default" HoverScale="1.06" PressedScale="0.95" OnClicked="NextTheme" Tooltip="Switch the color theme" />
    </HorizontalStack>

    <Label Name="StatusLabel" Text="{Binding Status}" Font="Body" Color="@TextMuted" WrapWidth="480" HAlign="Start" VAlign="Center" />
  </VerticalStack>
</Panel>
