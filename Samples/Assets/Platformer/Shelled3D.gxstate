{
  "Version": 1,
  "Entry": "Walk",
  "States": [
    {
      "Name": "Walk",
      "OnTick": [
        {
          "Do": "Enemy.Walk",
          "Params": {
            "Speed": 1.6,
            "AvoidEdges": true
          }
        }
      ]
    },
    {
      "Name": "Still",
      "OnEnter": [
        {
          "Do": "Enemy.Shell"
        }
      ],
      "OnTick": [
        {
          "Do": "Enemy.Shell"
        }
      ]
    },
    {
      "Name": "Sliding",
      "OnEnter": [
        {
          "Do": "Enemy.Slide",
          "Params": {
            "Speed": 11
          }
        }
      ],
      "OnTick": [
        {
          "Do": "Enemy.Slide",
          "Params": {
            "Speed": 11
          }
        }
      ]
    },
    {
      "Name": "Flying",
      "OnEnter": [
        {
          "Do": "Enemy.Fly"
        }
      ],
      "OnTick": [
        {
          "Do": "Enemy.Fly"
        }
      ]
    }
  ],
  "Transitions": [
    {
      "From": "Walk",
      "To": "Still",
      "On": "Stomped"
    },
    {
      "From": "Sliding",
      "To": "Still",
      "On": "Stomped"
    },
    {
      "From": "Still",
      "To": "Sliding",
      "When": [
        {
          "Event": "Stomped"
        },
        {
          "Time": 0.001
        }
      ]
    },
    {
      "From": "Still",
      "To": "Sliding",
      "On": "Kicked"
    }
  ],
  "AnyTransitions": [
    {
      "To": "Flying",
      "On": "KnockedOff",
      "Priority": 50
    }
  ]
}
