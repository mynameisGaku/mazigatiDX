      "When": [
        {
          "Time": 2.2
        },
        {
          "Key": "Lives",
          "Op": ">",
          "Value": 0
        }
      ]
    },
    {
      "From": "Dying",
      "To": "GameOver",
      "When": [
        {
          "Time": 2.2
        },
        {
